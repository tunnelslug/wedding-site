{
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/images/:path*", "destination": "/public/images/:path*" },
    { "source": "/fonts/:path*", "destination": "/public/fonts/:path*" },
    { "source": "/home.js", "destination": "/public/home.js" },
    { "source": "/home.css", "destination": "/public/home.css" },
    { "source": "/gallery.js", "destination": "/public/gallery.js" },
    { "source": "/gallery.css", "destination": "/public/gallery.css" },
    { "source": "/gallery-manifest.json", "destination": "/public/gallery-manifest.json" },
    { "source": "/photos", "destination": "/gallery.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src 'self' https://g1ebye9epu2u7epw.public.blob.vercel-storage.com; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
